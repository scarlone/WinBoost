<Window x:Class="WinBoost.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinBoost - ottimizzazione Windows con rollback"
        Height="760" Width="1240" MinHeight="480" MinWidth="860"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Le liste non usano la selezione del ListBox: il contenitore resta neutro. -->
        <Style x:Key="BareItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16,14,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================ intestazione: identita' e stato ================ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9"
                        Background="#1F4C87" BorderBrush="#2E6BB8" BorderThickness="1"
                        VerticalAlignment="Center">
                    <Path Data="M9 3 L15 10 H12 V15 H6 V10 H3 Z" Fill="#DCE8F6"
                          Width="15" Height="15" Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="WinBoost" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Ottimizzazione di sistema, sempre reversibile"
                               Style="{StaticResource Dim}" Margin="0,2,0,0" />
                </StackPanel>

                <Rectangle Grid.Column="2" Width="1" Fill="{StaticResource BorderSoft}"
                           Margin="20,4" />

                <TextBlock Grid.Column="3" Text="{Binding Hardware}" Style="{StaticResource Dim}"
                           LineHeight="16" VerticalAlignment="Center" Margin="0,0,16,0" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Notifica, non aggiornamento: WinBoost non scarica e non
                         sostituisce nulla da solo. Il download resta un gesto
                         dell'utente, sulla pagina della release. -->
                    <Border CornerRadius="5" Padding="10,4" Margin="0,0,8,0"
                            Background="#152A1B" BorderBrush="#2C5136" BorderThickness="1"
                            VerticalAlignment="Center"
                            ToolTip="{Binding UpdateTooltip}"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding UpdateHeadline}" FontSize="11"
                                       FontWeight="SemiBold" Foreground="{StaticResource Green}"
                                       VerticalAlignment="Center" />

                            <Button Command="{Binding UpdateActionCommand}"
                                    Content="{Binding UpdateActionText}"
                                    Style="{StaticResource Ghost}" Margin="10,0,0,0"
                                    Padding="8,3" FontSize="11" />

                            <Button Command="{Binding DisableUpdateCheckCommand}"
                                    Content="Non mostrare piu'"
                                    Style="{StaticResource Ghost}" Margin="4,0,0,0"
                                    Padding="8,3" FontSize="11"
                                    AutomationProperties.Name="Disattiva il controllo aggiornamenti"
                                    ToolTip="Disattiva il controllo all'avvio. La scelta viene salvata." />
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="5" Padding="10,5" Margin="0,0,8,0"
                            Background="#331715" BorderBrush="#6E322D" BorderThickness="1"
                            VerticalAlignment="Center"
                            ToolTip="Il catalogo non e' quello incorporato nell'eseguibile"
                            Visibility="{Binding IsExternalCatalog, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding CatalogWarning}" FontSize="11"
                                   Foreground="{StaticResource Red}" FontWeight="SemiBold" />
                    </Border>

                    <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,1,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Amber}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Green}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ElevationText}" FontSize="11"
                                       Foreground="{StaticResource TextDim}" />
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding ElevateCommand}" Margin="0"
                            AutomationProperties.Name="Riavvia come amministratore"
                            Visibility="{Binding IsElevated, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M8 1 L14 3.5 V7.5 C14 11.3 11.5 14.3 8 15.2 C4.5 14.3 2 11.3 2 7.5 V3.5 Z"
                                  Fill="{StaticResource TextDim}" Width="11" Height="12"
                                  Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="Riavvia come amministratore" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================ barra comandi: selezione e azioni ================ -->
        <Grid Grid.Row="1" Margin="2,0,2,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Preset" Foreground="{StaticResource TextFaint}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <ItemsControl ItemsSource="{Binding Presets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}"
                                    ToolTip="{Binding Description}"
                                    Command="{Binding DataContext.ApplyPresetCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Rectangle Width="1" Height="20" Fill="{StaticResource Border}" Margin="4,0,12,0" />
                <Button Content="Tutti" Style="{StaticResource Ghost}" Command="{Binding SelectAllCommand}" />
                <Button Content="Nessuno" Style="{StaticResource Ghost}" Command="{Binding SelectNoneCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource Pill}" Margin="0,0,12,0">
                    <TextBlock FontSize="11" Foreground="{StaticResource TextDim}"><Run
                        Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="SemiBold"
                        Foreground="{StaticResource Text}" /><Run Text=" selezionati" /></TextBlock>
                </Border>
                <Button Command="{Binding PreviewCommand}" AutomationProperties.Name="Anteprima">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE890;" Style="{StaticResource Icon}" FontSize="12"
                                   Margin="0,1,7,0" />
                        <TextBlock Text="Anteprima" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Primary}" Command="{Binding ApplyCommand}" Margin="0"
                        AutomationProperties.Name="Applica"
                        ToolTip="Disponibile solo con privilegi di amministratore"
                        ToolTipService.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="12"
                                   Foreground="#DCE8F6" VerticalAlignment="Center" Margin="0,1,7,0" />
                        <TextBlock Text="Applica" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================ indicatore di attivita' ================ -->
        <Border Grid.Row="2" Height="3" Margin="2,0,2,6" Background="Transparent" ClipToBounds="True">
            <Border Width="180" HorizontalAlignment="Left" CornerRadius="1.5"
                    Background="{StaticResource Accent}"
                    Visibility="{Binding Busy, Converter={StaticResource BoolVis}}">
                <Border.RenderTransform>
                    <TranslateTransform X="-190" />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Busy}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="BusySweep">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                From="-190" To="1500" Duration="0:0:1.4" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="BusySweep" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </Border>

        <!-- ================ contenuto ================ -->
        <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0" Padding="0">

            <!-- ======== tweak ======== -->
            <!-- Le intestazioni sono composite (testo + badge): senza un nome esplicito
                 UI Automation le espone senza etichetta e uno screen reader non le annuncia. -->
            <TabItem AutomationProperties.Name="Tweak">
                <TabItem.Header>
                    <TextBlock Style="{StaticResource TabHeaderText}" Text="Tweak" />
                </TabItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,0,2,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Style="{StaticResource SearchBox}" Width="280"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  Width="200" Margin="8,0,0,0" />
                        <!-- Con un filtro attivo il totale del catalogo sarebbe fuorviante:
                             mostra quanti risultati sono effettivamente in lista. -->
                        <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextFaint}" FontSize="11"
                                   Visibility="{Binding IsFiltered, Converter={StaticResource BoolVis}, ConverterParameter=invert}"><Run
                            Text="{Binding Tweaks.Count, Mode=OneWay}" /><Run
                            Text=" tweak nel catalogo" /></TextBlock>

                        <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextDim}" FontSize="11"
                                   Visibility="{Binding IsFiltered, Converter={StaticResource BoolVis}}"><Run
                            Text="{Binding VisibleCount, Mode=OneWay}" FontWeight="SemiBold"
                            Foreground="{StaticResource Text}" /><Run Text=" di " /><Run
                            Text="{Binding Tweaks.Count, Mode=OneWay}" /><Run
                            Text=" tweak" /></TextBlock>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <ListBox ItemsSource="{Binding TweaksView}" HorizontalContentAlignment="Stretch"
                                 ItemContainerStyle="{StaticResource BareItem}" Margin="0,2,0,2">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Grid Margin="14,14,16,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           FontSize="12" Foreground="{StaticResource Accent}" />
                                                <Border Grid.Column="1" Background="{StaticResource Surface2}"
                                                        CornerRadius="8" Padding="7,1" Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ItemCount}" FontSize="10"
                                                               Foreground="{StaticResource TextDim}" />
                                                </Border>
                                                <Rectangle Grid.Column="2" Height="1"
                                                           Fill="{StaticResource BorderSoft}"
                                                           Margin="12,1,0,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1"
                                            Padding="14,9,16,9">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1E2026" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                      IsEnabled="{Binding CanApply}" Margin="0,1,12,0" />

                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Id}" FontFamily="{StaticResource Mono}"
                                                               FontSize="10" Foreground="{StaticResource TextFaint}"
                                                               VerticalAlignment="Bottom" Margin="9,0,0,2" />
                                                </StackPanel>

                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Dim}"
                                                           Margin="0,2,0,0"
                                                           Visibility="{Binding Description, Converter={StaticResource NullVis}}" />

                                                <Grid Margin="0,4,0,0"
                                                      Visibility="{Binding HasWarning, Converter={StaticResource BoolVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}"
                                                               FontSize="11" Foreground="{StaticResource Amber}"
                                                               Margin="0,2,6,0" VerticalAlignment="Top" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Warning}"
                                                               TextWrapping="Wrap" FontSize="11"
                                                               Foreground="{StaticResource Amber}" />
                                                </Grid>

                                                <!-- Blocco (es. privilegi mancanti): informativo, non allarmante. -->
                                                <Grid Margin="0,4,0,0"
                                                      Visibility="{Binding BlockReason, Converter={StaticResource NullVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}"
                                                               FontSize="11" Foreground="{StaticResource TextFaint}"
                                                               Margin="0,2,6,0" VerticalAlignment="Top" />
                                                    <TextBlock Grid.Column="1" Text="{Binding BlockReason}"
                                                               TextWrapping="Wrap" FontSize="11"
                                                               Foreground="{StaticResource TextDim}" />
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Parameters}" Margin="0,8,0,2"
                                                              Visibility="{Binding HasParameters, Converter={StaticResource BoolVis}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#16171C" BorderBrush="{StaticResource BorderSoft}"
                                                                    BorderThickness="1" CornerRadius="5"
                                                                    Padding="11,8" Margin="0,0,0,5">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Key}" FontWeight="SemiBold"
                                                                               FontSize="11" Foreground="{StaticResource AccentSoft}" />
                                                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Dim}"
                                                                               Margin="0,3,0,0"
                                                                               Visibility="{Binding Note, Converter={StaticResource NullVis}}" />

                                                                    <!-- ItemTemplate esplicito invece di DisplayMemberPath:
                                                                         solo cosi' SelectionBoxItemTemplate viene popolato e
                                                                         la tendina chiusa mostra la label, non il ToString(). -->
                                                                    <ComboBox ItemsSource="{Binding Options}"
                                                                              SelectedItem="{Binding SelectedOption}"
                                                                              Width="280" HorizontalAlignment="Left" Margin="0,7,0,0"
                                                                              Visibility="{Binding IsChoice, Converter={StaticResource BoolVis}}">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Label}" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>

                                                                    <StackPanel Visibility="{Binding IsMultiSelect, Converter={StaticResource BoolVis}}">
                                                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Dim}"
                                                                                   Margin="0,7,0,5" />
                                                                        <ItemsControl ItemsSource="{Binding Toggles}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <CheckBox IsChecked="{Binding IsChecked}"
                                                                                              Content="{Binding Label}"
                                                                                              VerticalAlignment="Center"
                                                                                              FontSize="11" Margin="0,0,18,6" />
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Margin="14,1,0,0" VerticalAlignment="Top">
                                                <Border HorizontalAlignment="Right" CornerRadius="3" Padding="7,2"
                                                        BorderThickness="1"
                                                        Background="{Binding Risk, Converter={StaticResource RiskBrush}, ConverterParameter=bg}"
                                                        BorderBrush="{Binding Risk, Converter={StaticResource RiskBrush}, ConverterParameter=border}">
                                                    <TextBlock Text="{Binding RiskLabel}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}" />
                                                </Border>
                                                <TextBlock Text="{Binding Badges}" Style="{StaticResource Faint}"
                                                           HorizontalAlignment="Right" Margin="0,5,0,0"
                                                           Visibility="{Binding Badges, Converter={StaticResource NullVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ======== anteprima ======== -->
            <TabItem AutomationProperties.Name="Anteprima">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabHeaderText}" Text="Anteprima" />
                        <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="7,1"
                                Margin="7,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding PreviewItems.Count, Converter={StaticResource ZeroVis}, ConverterParameter=invert}">
                            <TextBlock Text="{Binding PreviewItems.Count}" FontSize="10"
                                       Foreground="{StaticResource TextDim}" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,12,0,0">
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DataGrid ItemsSource="{Binding PreviewItems}" AutoGenerateColumns="False"
                                  IsReadOnly="True" Background="Transparent" RowBackground="Transparent"
                                  BorderThickness="0" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource BorderSoft}"
                                  HeadersVisibility="Column" FontSize="12" RowHeaderWidth="0"
                                  CanUserResizeRows="False" CanUserReorderColumns="False"
                                  SelectionMode="Single" SelectionUnit="FullRow" Margin="4,2">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="skip">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Tweak" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding TweakName}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Kind}" FontFamily="{StaticResource Mono}"
                                                           FontSize="10" Foreground="{StaticResource TextFaint}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Bersaglio" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Target}" FontFamily="{StaticResource Mono}"
                                                       FontSize="11" Foreground="#B9BEC9" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Valore attuale e dopo" Width="380">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock TextWrapping="Wrap"><Run
                                                Text="{Binding Current, Mode=OneWay}"
                                                Foreground="#878D98" /><Run Text="  &#x2192;  "
                                                Foreground="{StaticResource TextFaint}" /><Run
                                                Text="{Binding Proposed, Mode=OneWay}"
                                                Foreground="{StaticResource AccentSoft}"
                                                FontWeight="SemiBold" /></TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="{Binding PreviewItems.Count, Converter={StaticResource ZeroVis}}">
                        <TextBlock Text="&#xE890;" FontFamily="{StaticResource Icons}" FontSize="30"
                                   Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" />
                        <TextBlock Text="Nessuna anteprima eseguita" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"
                                   Margin="0,12,0,4" />
                        <TextBlock Text="Seleziona i tweak nella prima scheda e premi Anteprima: vedrai ogni modifica, senza toccare il sistema."
                                   Style="{StaticResource Dim}" TextAlignment="Center" MaxWidth="400" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ======== cronologia ======== -->
            <TabItem AutomationProperties.Name="Cronologia e rollback">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabHeaderText}" Text="Cronologia e rollback" />
                        <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="7,1"
                                Margin="7,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding Sessions.Count, Converter={StaticResource ZeroVis}, ConverterParameter=invert}">
                            <TextBlock Text="{Binding Sessions.Count}" FontSize="10"
                                       Foreground="{StaticResource TextDim}" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,2,10">
                        <Button Style="{StaticResource Ghost}" Command="{Binding RefreshSessionsCommand}"
                                AutomationProperties.Name="Aggiorna">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12"
                                           Margin="0,1,7,0" />
                                <TextBlock Text="Aggiorna" />
                            </StackPanel>
                        </Button>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Dim}" Margin="6,0,0,0"
                                   Text="Ogni applicazione registra i valori precedenti: il rollback li ripristina uno per uno." />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding Sessions}" HorizontalContentAlignment="Stretch"
                                 ItemContainerStyle="{StaticResource BareItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" CornerRadius="6" Padding="14,11"
                                            Margin="2,0,2,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                                    Background="{StaticResource Surface2}" Margin="0,0,12,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="&#xE81C;" FontFamily="{StaticResource Icons}"
                                                           FontSize="14" Foreground="{StaticResource TextDim}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding Converter={StaticResource SessionSummary}}" />
                                                <TextBlock FontFamily="{StaticResource Mono}" FontSize="10"
                                                           Foreground="{StaticResource TextFaint}" Margin="0,3,0,0"
                                                           Text="{Binding Id, StringFormat=sessione {0}}" />
                                            </StackPanel>

                                            <Button Grid.Column="2" Style="{StaticResource Danger}" Margin="0"
                                                    AutomationProperties.Name="Annulla modifiche"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RollbackCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource Icons}"
                                                               FontSize="12" Foreground="{StaticResource Red}"
                                                               VerticalAlignment="Center" Margin="0,1,7,0" />
                                                    <TextBlock Text="Annulla modifiche" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding Sessions.Count, Converter={StaticResource ZeroVis}}">
                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource Icons}" FontSize="30"
                                       Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" />
                            <TextBlock Text="Nessuna sessione registrata" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"
                                       Margin="0,12,0,4" />
                            <TextBlock Text="Quando applichi dei tweak, qui compare la sessione con i valori precedenti e il pulsante per annullarla."
                                       Style="{StaticResource Dim}" TextAlignment="Center" MaxWidth="400" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ================ registro attivita' ================ -->
        <Border Grid.Row="4" Background="{StaticResource ConsoleBg}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="7" Height="118" Margin="0,12,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="0,0,0,1" Padding="12,5">
                    <TextBlock Text="REGISTRO ATTIVITA'" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextFaint}" />
                </Border>
                <Grid>
                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="12,7">
                        <ItemsControl ItemsSource="{Binding LogLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource Mono}" FontSize="11"
                                               Foreground="{StaticResource ConsoleText}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="In attesa di operazioni: qui compaiono anteprime, applicazioni e rollback."
                               Style="{StaticResource Dim}" FontStyle="Italic" Margin="12,8"
                               Visibility="{Binding LogLines.Count, Converter={StaticResource ZeroVis}}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- ================ barra di stato ================ -->
        <Grid Grid.Row="5" Margin="2,9,2,0">
            <TextBlock Text="{Binding Status}" Style="{StaticResource Dim}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource Icons}" FontSize="11"
                           Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"
                           Margin="0,1,6,0" />
                <TextBlock Text="L'anteprima non modifica nulla e ogni applicazione e' annullabile"
                           Style="{StaticResource Dim}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

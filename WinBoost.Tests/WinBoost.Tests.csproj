<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinBoost.Core\WinBoost.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- I test girano contro il catalogo reale, non contro una copia divergente. -->
    <None Include="..\data\tweaks.json" Link="data\tweaks.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\data\nvidia-profiles.json" Link="data\nvidia-profiles.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Il manifest reale, non una copia: il test sorveglia che l'eseguibile
         non cominci a chiedere l'elevazione all'avvio. -->
    <None Include="..\WinBoost.App\app.manifest" Link="app.manifest" CopyToOutputDirectory="PreserveNewest" />
    <!-- Il README dichiara numeri ricavati dal catalogo: un test li ricontrolla,
         cosi' non invecchiano in silenzio a ogni tweak aggiunto. -->
    <None Include="..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
